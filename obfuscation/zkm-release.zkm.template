classpath "@ZKM_CLASSPATH@";
open "@INPUT_JAR@";

// Replace the implementation's inherited/default name exclusions with this
// audited whitelist. Without this reset the test-compatible build keeps every
// opened class name even though flow and literal transforms still run.
resetExclusions;

// Keep only manifest, JNI, native digest, reflection and package-access ABI.
// Unlisted Yozakura classes remain eligible for package collapse and renaming.
exclude class gq.yozakura(YozakuraAttachPoint);
exclude class gq.yozakura(YozakuraBootstrap);
exclude class gq.yozakura(Yozakuraloader);
exclude class gq.yozakura.bridge(IsolatedClientClassLoader);
exclude class gq.yozakura.bridge(VanillaRemapClassLoader);
exclude class gq.yozakura.util.plugin(ProductPlugin*);
exclude class gq.yozakura.yozakura(ClassTransformer*);
exclude class gq.yozakura.core(Client*);
exclude class gq.yozakura.core(StandaloneClient*);
exclude class gq.yozakura.core(ModernForgeClient*);

// A/B companions have package-private constructors and synthetic accessors.
// Their names and package must stay with the fixed JNI/JNIC outer classes.
exclude class gq.yozakura.k(A*);
exclude class gq.yozakura.k(B*);
exclude class gq.yozakura.k.vendor.tech.skidonion.obfuscator.inline(C*);

// Native exports and native RegisterNatives look these classes up by name.
exclude class gq.yozakura.ui.click.web(WebView2Bridge*);
exclude class gq.yozakura.ui.click.yozakura(PanelClickGuiWindowsAlphaCursor*);

// Native runtime digest and explicitly inspected bridge contracts.
exclude class gq.yozakura.module(Module);
exclude class gq.yozakura.event.bus(EventManager);
exclude class gq.yozakura.bridge(MovementInputBridge);
exclude class gq.yozakura.ui.click.material(MaterialClickGui*);
exclude class gq.yozakura.ui.click.sakura(SakuraClickGui*);
exclude class gq.yozakura.ui.click.yozakura(YozakuraClickGui*);

// Manifest, reflection and JNI method/field contracts.
exclude gq.yozakura.YozakuraAttachPoint^agentmain(*);
exclude gq.yozakura.YozakuraBootstrap^start(*);
exclude gq.yozakura.Yozakuraloader^inject(*);
exclude gq.yozakura.core.Client^showInjectionSuccessAnimation(*);
exclude gq.yozakura.core.Client^markConfigDirty(*);
exclude gq.yozakura.core.StandaloneClient^showInjectionSuccessAnimation(*);
exclude gq.yozakura.core.StandaloneClient^isState(*);
exclude gq.yozakura.core.StandaloneClient^shutdownForReinjection(*);
exclude gq.yozakura.core.StandaloneClient^isShutdownComplete(*);
exclude gq.yozakura.core.ModernForgeClient^showInjectionSuccessAnimation(*);
exclude gq.yozakura.core.ModernForgeClient^isState(*);
exclude gq.yozakura.k.A^*(*);
exclude gq.yozakura.k.B^*(*);
exclude gq.yozakura.ui.click.web.WebView2Bridge^*(*);
exclude gq.yozakura.ui.click.yozakura.PanelClickGuiWindowsAlphaCursor^*(*);
exclude gq.yozakura.core.Client.state;
exclude gq.yozakura.core.Client.name;
exclude gq.yozakura.core.Client.config;
exclude gq.yozakura.core.Client.MessageON;
exclude gq.yozakura.core.Client.CHINESE;

// The GL-heavy compatibility overlay is physically removed from the ZKM input
// because this test-compatible implementation analyzes fixed classes while saving.
// The pipeline supplies that minimal overlay as library bytecode and restores it unchanged.
obfuscateFlowExclude gq.yozakura.util.render.HudDockingCoordinator$NodeInput;

// Do not alter flow or literal initialization at native and JNIC boundaries.
obfuscateFlowExclude gq.yozakura.k.A* and
        gq.yozakura.k.B* and
        gq.yozakura.k.vendor.tech.skidonion.obfuscator.inline.C* and
        gq.yozakura.ui.click.web.WebView2Bridge* and
        gq.yozakura.ui.click.yozakura.PanelClickGuiWindowsAlphaCursor*;
stringEncryptionExclude gq.yozakura.k.A* and
        gq.yozakura.k.B* and
        gq.yozakura.k.vendor.tech.skidonion.obfuscator.inline.C* and
        gq.yozakura.ui.click.web.WebView2Bridge* and
        gq.yozakura.ui.click.yozakura.PanelClickGuiWindowsAlphaCursor*;

// Reference obfuscation is deliberately focused on private login-panel calls.
// Broad reflective replacement in render/tick paths would add unacceptable cost.
obfuscateReferencesInclude
        containedIn{gq.yozakura.k.vendor.skidonion.sWdSl.* *(*)}
        gq.yozakura.k.vendor.skidonion.sWdSl.* private *(*);

@DYNAMIC_EXCLUDES@

obfuscate changeLogFileOut="@CHANGE_LOG@"
          aggressiveMethodRenaming=false
          newNameCharacters=ASCII
          keepInnerClassInfo=ifNameNotObfuscated
          keepGenericsInfo=false
          obfuscateFlow=normal
          exceptionObfuscation=light
          encryptStringLiterals=enhanced
          encryptIntegerConstants=normal
          encryptLongConstants=normal
          collapsePackagesWithDefault="n"
          mixedCaseClassNames=false
          lineNumbers=delete
          localVariables=delete
          methodParameters=delete
          randomize=true
          obfuscateReferences=normal
          obfuscateReferenceStructures=inReferencingClasses
          autoReflectionHandling=none
          methodParameterChanges=none
          obfuscateParameters=none
          makeClassesPublic=false
          keepBalancedLocks=true
          preverify=true
          assumeRuntimeVersion="8";
saveAll "@OUTPUT_JAR@";
