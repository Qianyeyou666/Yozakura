<?xml version="1.0" encoding="UTF-8"?>
<jnic>
    <targets>
        <target>WINDOWS_X86_64</target>
    </targets>
    <options>
        <stringObf>true</stringObf>
        <flowObf>false</flowObf>
        <fastCompile>false</fastCompile>
        <useIntrinsics>false</useIntrinsics>
    </options>
    <include>
        <match className="gq/yozakura/k/B" methodName="(getVerifiedUsername|allowRuntime|requireRuntime)" />
    </include>
    <exclude>
        <match className="gq/yozakura/k/B" methodName="&lt;(init|clinit)&gt;" />
        <match className="gq/yozakura/k/B" methodName="verifyOrThrow" />
        <match className="gq/yozakura/k/B" methodName="showVerification" />
    </exclude>
</jnic>
