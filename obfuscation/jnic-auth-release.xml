<?xml version="1.0" encoding="UTF-8"?>
<jnic>
    <targets>
        <target>WINDOWS_X86_64</target>
    </targets>
    <options>
        <stringObf>true</stringObf>
        <flowObf>true</flowObf>
        <fastCompile>false</fastCompile>
        <useIntrinsics>false</useIntrinsics>
    </options>
    <include>
        <match className="gq/yozakura/auth/NativeAuthBridge" methodName="(login|redeemLicense|getVerifiedUsername|getVerifiedRole|getVerifiedExpiry|requireNativeRuntime)" />
        <match className="gq/yozakura/auth/YozakuraAuthGate" methodName="(verifyOrThrow|getVerifiedUsername|requireRuntime)" />
    </include>
    <exclude>
        <match className="gq/yozakura/auth/NativeAuthBridge" methodName="&lt;(init|clinit)&gt;" />
        <match className="gq/yozakura/auth/YozakuraAuthGate" methodName="&lt;(init|clinit)&gt;" />
    </exclude>
</jnic>
