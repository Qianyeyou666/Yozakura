# Yozakura Club listens on loopback and must be published through an HTTPS reverse proxy.
PORT=4173
YOZAKURA_DATA_DIR=/var/lib/yozakura-club
# Public site: https://yozakura.wtf
# OpenClaw stays on loopback for server-to-server calls; clients use https://auth.yozakura.wtf.
YOZAKURA_VERIFY_INTROSPECTION_URL=http://127.0.0.1:8080/api/v2/verify/introspect
YOZAKURA_VERIFY_REDEEM_URL=http://127.0.0.1:8080/internal/api/accounts/redeem
YOZAKURA_VERIFY_PROFILE_URL=http://127.0.0.1:8080/internal/api/accounts/profile
# Must exactly match OPENCLAW_SERVICE_SECRET and remain independent from other secrets.
YOZAKURA_VERIFY_SERVICE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_BASE64URL

# Release payloads must stay outside /opt/yozakura-club/public.
# Downloads require a signed-in account.
YOZAKURA_CLIENT_FILE=/var/lib/yozakura-releases/yozakura-client.zip
